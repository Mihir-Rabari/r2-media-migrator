{
  "name": "media-migrate",
  "version": "0.1.0",
  "description": "Resumable, verifiable media optimization and reference-migration CLI for S3-compatible storage (Cloudflare R2) and MongoDB",
  "license": "MIT",
  "type": "commonjs",
  "engines": { "node": ">=22.5" },
  "bin": { "media-migrate": "dist/cli/main.js" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 --test-timeout=120000 \"dist-test/tests/**/*.test.js\"",
    "pretest": "tsc -p tsconfig.test.json",
    "test:unit": "npm run pretest && node --test \"dist-test/tests/unit/*.test.js\"",
    "audit:deps": "npm audit --omit=dev",
    "start": "node dist/cli/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "mongodb": "^6.10.0",
    "sharp": "^0.34.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.6.0"
  }
}
