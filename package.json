{
  "name": "media-migrate",
  "version": "0.1.0",
  "description": "Resumable, verifiable media optimization and reference-migration CLI for S3-compatible storage (Cloudflare R2) and MongoDB",
  "license": "MIT",
  "type": "commonjs",
  "engines": { "node": ">=22.13" },
  "bin": { "media-migrate": "dist/cli/main.js" },
  "main": "dist/index.js",
  "files": ["dist", "examples", "docs", "reports/media-migration", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "npm run typecheck && node scripts/check-repo.js",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "npm run build && node --test --test-concurrency=1 --test-timeout=180000 \"dist-test/tests/**/*.test.js\"",
    "test:fast": "npm run pretest && node --test --test-concurrency=1 \"dist-test/tests/unit/*.test.js\" \"dist-test/tests/contract/*.test.js\" \"dist-test/tests/security/*.test.js\"",
    "test:unit": "npm run pretest && node --test \"dist-test/tests/unit/*.test.js\"",
    "test:fault": "npm run pretest && node --test --test-concurrency=1 \"dist-test/tests/fault-injection/*.test.js\"",
    "test:e2e": "npm run build && npm run pretest && node --test --test-concurrency=1 --test-timeout=180000 \"dist-test/tests/e2e/*.test.js\"",
    "simulate:v2": "npm run build && npm run pretest && node dist-test/tests/perf/simulate-v2.js",
    "docs:config": "npm run build && node scripts/gen-config-doc.js",
    "docs:state": "npm run build && node scripts/gen-state-doc.js",
    "audit:deps": "npm audit --omit=dev",
    "start": "node dist/cli/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "mongodb": "^6.10.0",
    "sharp": "^0.34.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.6.0"
  }
}
